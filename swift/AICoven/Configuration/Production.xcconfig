// Production Configuration
// Secrets.xcconfig overrides the YOUR_* placeholders below with real values.
// See Secrets.xcconfig.template for setup instructions.

// API Environment
APP_ENV = production


// Firebase Configuration
// Create a Firebase project at https://console.firebase.google.com
// and replace the placeholders below with your project's values.
FIREBASE_API_KEY = YOUR_FIREBASE_API_KEY
FIREBASE_PROJECT_ID = YOUR_FIREBASE_PROJECT_ID
FIREBASE_APP_ID = YOUR_FIREBASE_APP_ID
FIREBASE_AUTH_DOMAIN = YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_STORAGE_BUCKET = YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID = YOUR_SENDER_ID

// Google Drive Picker (optional – only needed for Google Drive integration)
GOOGLE_PICKER_API_KEY = YOUR_GOOGLE_PICKER_API_KEY
GOOGLE_PICKER_APP_ID = YOUR_GOOGLE_PICKER_APP_ID

// Connected Apps – AICoven Local's own OAuth client IDs (not secrets: they ship in the app).
// A fork with its own GitHub and Google apps sets them in Secrets.xcconfig.
GITHUB_OAUTH_CLIENT_ID = Iv23liJu04XRFISDVMBO
GOOGLE_OAUTH_CLIENT_ID = 870439799161-1c7u8utd0t0kh3ote5kugh8cj9961ugb.apps.googleusercontent.com

// App Identifiers
PRODUCT_BUNDLE_IDENTIFIER_IOS = com.aicoven.com
PRODUCT_BUNDLE_IDENTIFIER_MACOS = com.aicoven.com

// App Display Name
PRODUCT_NAME = AICoven

// Code Signing
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = // Add your team ID here

// Last, so that its values take the place of the ones above.
#include? "Secrets.xcconfig"
