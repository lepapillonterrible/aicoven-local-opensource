// Secrets Configuration Template
// Copy this file to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored and will NOT be committed.
//
// The main xcconfig files (Development/Staging/Production) include
// Secrets.xcconfig via #include? so values here override placeholders.

// Firebase Configuration
// Create a Firebase project at https://console.firebase.google.com
FIREBASE_API_KEY = YOUR_FIREBASE_API_KEY
FIREBASE_PROJECT_ID = YOUR_FIREBASE_PROJECT_ID
FIREBASE_APP_ID = YOUR_FIREBASE_APP_ID
FIREBASE_AUTH_DOMAIN = YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_STORAGE_BUCKET = YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID = YOUR_SENDER_ID

// Google Drive Picker (optional – only needed for Google Drive integration)
// Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_PICKER_API_KEY = YOUR_GOOGLE_PICKER_API_KEY
GOOGLE_PICKER_APP_ID = YOUR_GOOGLE_PICKER_APP_ID

// Connected Apps – OAuth Client IDs (optional)
// GitHub: Create an OAuth App at https://github.com/settings/developers
// Google: Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GITHUB_OAUTH_CLIENT_ID = YOUR_GITHUB_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID = YOUR_GOOGLE_OAUTH_CLIENT_ID

// Personal LLM provider keys (optional)
// GEMINI_API_KEY = your_key_here
