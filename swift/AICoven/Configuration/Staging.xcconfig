// Staging Configuration
// Secrets.xcconfig overrides the YOUR_* placeholders below with real values.
// See Secrets.xcconfig.template for setup instructions.
#include? "Secrets.xcconfig"

// API Environment
APP_ENV = staging


// Firebase Configuration
// Create a Firebase project at https://console.firebase.google.com
// and replace the placeholders below with your project's values.
FIREBASE_API_KEY = YOUR_FIREBASE_API_KEY
FIREBASE_PROJECT_ID = YOUR_FIREBASE_PROJECT_ID
FIREBASE_APP_ID = YOUR_FIREBASE_APP_ID
FIREBASE_AUTH_DOMAIN = YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_STORAGE_BUCKET = YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID = YOUR_SENDER_ID

// Google Drive Picker (optional – only needed for Google Drive integration)
GOOGLE_PICKER_API_KEY = YOUR_GOOGLE_PICKER_API_KEY
GOOGLE_PICKER_APP_ID = YOUR_GOOGLE_PICKER_APP_ID

// Connected Apps – OAuth Client IDs (optional – only needed for GitHub/Google integrations)
GITHUB_OAUTH_CLIENT_ID = YOUR_GITHUB_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID = YOUR_GOOGLE_OAUTH_CLIENT_ID

// App Identifiers
PRODUCT_BUNDLE_IDENTIFIER_IOS = com.aicoven.com.staging
PRODUCT_BUNDLE_IDENTIFIER_MACOS = com.aicoven.com.staging

// App Display Name
PRODUCT_NAME = AICoven Staging

// Code Signing
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = // Add your team ID here

